  /* ── ARTIST RESULT CARD ── */
  .artists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1px;
    background: var(--border);
    margin: 0 2rem;
    border: 1px solid var(--border);

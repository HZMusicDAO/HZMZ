      html += `<div class="results-section-header">
        <span class="results-section-label">Playlists</span>
        <span class="results-section-count">${playlists.length} results</span>
      </div>
      <div class="playlists-grid">`;
      playlists.forEach(p => { html += renderPlaylistCard(p, false); });
      html += `</div>`;
    }

    if (!html) {
      html = `<div class="no-results">No ${activeTab} found</div>`;
    }

    resultsArea.innerHTML = html;
  }

  // ── Row/card renderers ──
  function artSrc(artwork, size) {
    if (!artwork) return null;
    return artwork[size] || artwork['150x150'] || artwork['480x480'] || null;
  }

  function renderTrackRow(t) {
    trackRegistry[t.id] = t;
    const art = artSrc(t.artwork, '150x150');
    const artHtml = art
      ? `<img src="${art}" alt="" loading="lazy" onerror="this.parentElement.innerHTML='♪'" />`
      : '♪';
    // Build Audius track URL: permalink field is the canonical path, e.g. /artisthandle/track-slug
    const trackUrl = t.permalink
      ? `https://audius.co${t.permalink}`
      : (t.user?.handle && t.slug ? `https://audius.co/${t.user.handle}/${t.slug}` : null);
    return `<div class="result-track">
      <div class="result-track-left" onclick="playRegisteredTrack('${t.id}')">
        <div class="result-art">
          ${artHtml}
          <div class="result-play-btn">▶</div>
        </div>
        <div class="result-info">
          <div class="result-title">${escHtml(t.title || 'Unknown')}</div>
          <div class="result-sub">${escHtml(t.user?.name || '—')}${t.genre ? ' · ' + escHtml(t.genre) : ''}</div>
        </div>
      </div>
      <div class="result-track-right">
        ${t.play_count ? `<span class="result-plays">${fmtNum(t.play_count)}</span>` : ''}
        ${t.duration   ? `<span class="result-dur">${fmtTime(t.duration)}</span>` : ''}
        ${t.user?.id ? `<button class="result-link-btn" title="View artist" onclick="event.stopPropagation();openArtistDrawer('${t.user.id}')">◉</button>` : ''}
      </div>
    </div>`;
  }

  function renderArtistCard(a) {
    const pic = a.profile_picture ? (a.profile_picture['150x150'] || a.profile_picture['480x480']) : null;
    const picHtml = pic
      ? `<img src="${pic}" alt="" loading="lazy" onerror="this.parentElement.textContent='♪'" />`
      : '♪';
    const profileUrl = a.handle ? `https://audius.co/${a.handle}` : null;
    return `<div class="result-artist" onclick="openArtistDrawer('${a.id}')">
      <div class="artist-avatar">${picHtml}</div>
      <div>
        <div class="artist-name">${escHtml(a.name || a.handle || 'Unknown')}</div>
        ${a.follower_count ? `<div class="artist-followers">${fmtNum(a.follower_count)} followers</div>` : ''}
        ${a.track_count   ? `<div class="artist-track-count">${a.track_count} tracks</div>` : ''}
      </div>

    </div>`;
  }

  function renderPlaylistCard(p, isAlbum) {
    // Store in registry so we can retrieve the full object from onclick
    trackRegistry['pl_' + p.id] = p;
    const art = p.artwork ? (p.artwork['150x150'] || p.artwork['480x480']) : null;
    const artHtml = art
      ? `<img src="${art}" alt="" loading="lazy" onerror="this.parentElement.textContent='♪'" />`
      : (isAlbum ? '💿' : '♫');
    const trackCount = p.playlist_contents?.track_ids?.length || p.track_count || 0;
    return `<div class="result-playlist" onclick="openPlaylistPanel(trackRegistry['pl_${p.id}'])" style="cursor:pointer;">
      <div class="playlist-art">${artHtml}</div>
      <div class="playlist-info">
        ${isAlbum ? '<span class="album-badge">Album</span>' : ''}
        <div class="playlist-name">${escHtml(p.playlist_name || p.name || 'Unknown')}</div>
        <div class="playlist-owner" onclick="event.stopPropagation();openArtistDrawer('${p.user?.id}')" style="cursor:pointer;transition:color 0.15s;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color=''">${escHtml(p.user?.name || '—')}</div>
        ${trackCount ? `<div class="playlist-track-count">${trackCount} tracks</div>` : ''}
        <div style="margin-top:0.35rem;display:flex;gap:0.4rem;flex-wrap:wrap;">
          <span class="playlist-link-btn" onclick="event.stopPropagation();openPlaylistPanel(trackRegistry['pl_${p.id}'])" style="display:inline-flex;opacity:1;cursor:pointer;">▶ ${isAlbum ? 'OPEN ALBUM' : 'OPEN PLAYLIST'}</span>
          <span class="playlist-link-btn" onclick="event.stopPropagation();openArtistDrawer('${p.user?.id}')" style="display:inline-flex;opacity:1;cursor:pointer;">◉ ARTIST</span>
        </div>
      </div>
    </div>`;
  }

  // ── Play a track from search results ──
  function playSearchTrack(id, trackObj) {
    // Find or insert the track into the global tracks array
    let idx = tracks.findIndex(t => t.id === id);
    if (idx === -1) {
      tracks.unshift(trackObj);
      idx = 0;
    }

    // Close search UI without clearing DOM
    closeSearch();
    searchInput.value = '';
    searchClear.classList.remove('visible');

    // If the main app hasn't rendered yet (first load failed / demo), render now
    const appEl = document.getElementById('app');
    const heroExists = appEl && appEl.querySelector('#heroSection');
    if (!heroExists) {
      renderApp(tracks);
      // After renderApp, play after a tick for DOM to settle
      setTimeout(() => { currentIndex = -1; playTrack(idx); }, 100);
      return;
    }

    // App is already rendered — just update hero info and play directly
    currentIndex = idx;
    updateHeroInfo(trackObj);
    loadArtistTracks(trackObj);

    // Highlight the row if it's visible in the track list
    document.querySelectorAll('.track-row').forEach(r => r.classList.remove('active'));
    const rows = document.querySelectorAll('.track-row');
    const visibleTracks = currentGenre === 'all' ? tracks : tracks.filter(t => t.genre === currentGenre);
    visibleTracks.forEach((t, i) => {
      if (t.id === id && rows[i]) rows[i].classList.add('active');
    });

    // Set stream src and play
    audio.src = `${BASE}/tracks/${id}/stream`;
    audio.play().then(() => {
      isPlaying = true;
      updatePlayBtn();
    }).catch(() => {
      isPlaying = false;
      updatePlayBtn();
    });
  }

  // ── Artist profile drawer ──
  async function openArtistDrawer(userId) {
    if (!userId) return;
    pushView('artist', { userId });
    const scrim  = document.getElementById('drawerScrim');
    const drawer = document.getElementById('profileDrawer');
    const body   = document.getElementById('drawerBody');

    scrim.classList.add('open');
    drawer.classList.add('open');
    body.innerHTML = `<div class="drawer-loading"><div class="search-spinner"></div></div>`;

    await _fetchAndRenderDrawer(userId);
  }

  async function _fetchAndRenderDrawer(userId) {
    const body = document.getElementById('drawerBody');
    if (!body) return;
    try {
      // Fetch user info, tracks, and all playlists (albums have is_album=true).
      // Try /albums endpoint first; if it fails (404/not supported), fall back to
      // filtering playlists. Both fetches run in parallel for speed.
      const [userRes, tracksRes, albumsRes, playlistsRes] = await Promise.allSettled([
        apiFetch(`${SEARCH_BASE}/users/${userId}`),
        apiFetch(`${SEARCH_BASE}/users/${userId}/tracks?limit=25&sort=plays`),
        apiFetch(`${SEARCH_BASE}/users/${userId}/albums?limit=50`),
        apiFetch(`${SEARCH_BASE}/users/${userId}/playlists?limit=50`),
      ]);

      const user      = userRes.status   === 'fulfilled' ? userRes.value?.data      : null;
      const userTracks= tracksRes.status === 'fulfilled' ? (tracksRes.value?.data    || []) : [];

      // Albums: prefer dedicated endpoint; fall back to is_album filter from playlists call
      let albums = [];
      if (albumsRes.status === 'fulfilled' && albumsRes.value?.data?.length) {
        albums = albumsRes.value.data;
      } else if (playlistsRes.status === 'fulfilled') {
        albums = (playlistsRes.value?.data || []).filter(p => p.is_album);
      }

      // Playlists: if dedicated albums call succeeded, use playlists as-is; otherwise filter out albums
      let playlists = [];
      if (playlistsRes.status === 'fulfilled') {
        const raw = playlistsRes.value?.data || [];
        playlists = albumsRes.status === 'fulfilled' && albumsRes.value?.data?.length
          ? raw
          : raw.filter(p => !p.is_album);
      }

      if (!user) throw new Error('User not found');

      const pic = user.profile_picture ? (user.profile_picture['480x480'] || user.profile_picture['150x150']) : null;

      let html = `
        <div class="drawer-artist-hero">
          <div class="drawer-avatar">
            ${pic ? `<img src="${pic}" alt="" onerror="this.parentElement.textContent='♪'" />` : '♪'}
          </div>
          <div>
            <div class="drawer-artist-name">${escHtml(user.name || user.handle)}</div>
            <div class="drawer-artist-handle">@${escHtml(user.handle)}</div>
          </div>
        </div>
        <div class="drawer-stats-row">
          ${user.follower_count !== undefined ? `<div class="drawer-stat"><div class="drawer-stat-val">${fmtNum(user.follower_count)}</div><div class="drawer-stat-label">Followers</div></div>` : ''}
          ${user.followee_count !== undefined ? `<div class="drawer-stat"><div class="drawer-stat-val">${fmtNum(user.followee_count)}</div><div class="drawer-stat-label">Following</div></div>` : ''}
          ${user.track_count   !== undefined ? `<div class="drawer-stat"><div class="drawer-stat-val">${user.track_count}</div><div class="drawer-stat-label">Tracks</div></div>` : ''}
          ${user.playlist_count!== undefined ? `<div class="drawer-stat"><div class="drawer-stat-val">${user.playlist_count}</div><div class="drawer-stat-label">Playlists</div></div>` : ''}
        </div>
      `;

      if (user.bio) {
        html += `<div class="drawer-bio">${escHtml(user.bio)}</div>`;
      }

      // External links
      const links = [];
      if (user.website)  links.push(`<a class="drawer-ext-link" href="${user.website}" target="_blank">↗ Website</a>`);
      if (user.twitter_handle) links.push(`<a class="drawer-ext-link" href="https://twitter.com/${user.twitter_handle}" target="_blank">↗ Twitter</a>`);
      if (user.instagram_handle) links.push(`<a class="drawer-ext-link" href="https://instagram.com/${user.instagram_handle}" target="_blank">↗ Instagram</a>`);
      // Audius profile is the app itself — no external link needed
      html += `<div style="margin-bottom:0.75rem;">${links.join('')}</div>`;

      // Tracks — register in trackRegistry keyed by id for safe onclick
      if (userTracks.length) {
        html += `<div class="drawer-section-title">Tracks (${userTracks.length})</div>`;
        userTracks.forEach((t, i) => {
          trackRegistry[t.id] = t;
          const tart = t.artwork ? (t.artwork['150x150'] || t.artwork['480x480']) : null;
          html += `<div class="drawer-track-row" onclick="playRegisteredTrack('${t.id}')">
            <span class="drawer-track-num">${i+1}</span>
            <div class="drawer-track-art">${tart ? `<img src="${tart}" loading="lazy" onerror="this.parentElement.textContent='♪'" />` : '♪'}</div>
            <div class="drawer-track-info">
              <div class="drawer-track-name">${escHtml(t.title || 'Unknown')}</div>
              ${t.play_count ? `<div class="drawer-track-plays">${fmtNum(t.play_count)} plays</div>` : ''}
            </div>
          </div>`;
        });
      }

      // Albums
      if (albums.length) {
        html += `<div class="drawer-section-title">Albums (${albums.length})</div>`;
        albums.forEach(p => {
          const part = p.artwork ? (p.artwork['150x150'] || p.artwork['480x480']) : null;
          const tc   = p.playlist_contents?.track_ids?.length || p.track_count || 0;
          trackRegistry['pl_' + p.id] = p;
          html += `<div class="drawer-playlist-row" style="cursor:pointer" onclick="openPlaylistPanel(trackRegistry['pl_${p.id}'])">
            <div class="drawer-pl-art">${part ? `<img src="${part}" loading="lazy" onerror="this.parentElement.textContent='💿'" />` : '💿'}</div>
            <div class="drawer-pl-info">
              <div class="drawer-pl-name">${escHtml(p.playlist_name || 'Unknown Album')}</div>
              ${tc ? `<div class="drawer-pl-count">${tc} tracks</div>` : ''}
            </div>
          </div>`;
        });
      }

      // Playlists
      if (playlists.length) {
        html += `<div class="drawer-section-title">Playlists (${playlists.length})</div>`;
        playlists.forEach(p => {
          const part = p.artwork ? (p.artwork['150x150'] || p.artwork['480x480']) : null;
          const tc   = p.playlist_contents?.track_ids?.length || p.track_count || 0;
          trackRegistry['pl_' + p.id] = p;
          html += `<div class="drawer-playlist-row" style="cursor:pointer" onclick="openPlaylistPanel(trackRegistry['pl_${p.id}'])">
            <div class="drawer-pl-art">${part ? `<img src="${part}" loading="lazy" onerror="this.parentElement.textContent='♫'" />` : '♫'}</div>
            <div class="drawer-pl-info">
              <div class="drawer-pl-name">${escHtml(p.playlist_name || 'Unknown Playlist')}</div>
              ${tc ? `<div class="drawer-pl-count">${tc} tracks</div>` : ''}
            </div>
          </div>`;
        });
      }

      body.innerHTML = html;

    } catch(e) {
      body.innerHTML = `<div class="search-empty"><div class="search-empty-icon">⊘</div><div class="search-empty-text">Could not load profile</div></div>`;
    }
  }

  function closeDrawer() {
    document.getElementById('drawerScrim').classList.remove('open');
    document.getElementById('profileDrawer').classList.remove('open');
    if (currentView.view === 'artist') {
      // Go back to previous view (search or home)
      if (historyStack.length) {
        navBack();
      } else {
        pushView('home');
      }
    }
  }

  // ── Helpers ──
  function fmtNum(n) {
    if (!n) return '0';
    if (n >= 1e6) return (n/1e6).toFixed(1)+'M';
    if (n >= 1e3) return (n/1e3).toFixed(0)+'K';
    return String(n);
  }

  function escHtml(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // Close search when clicking outside
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      if (document.getElementById('profileDrawer').classList.contains('open')) { closeDrawer(); return; }
      if (searchPanel.classList.contains('open')) { clearSearch(); return; }
    }
    // Cmd/Ctrl+K to focus search
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      searchInput.focus();
      openSearchPanel();
    }
  });


  // ── Artist Suggestions ──
  let currentArtistId = null;
  let artistTracksCache = {}; // artistId -> tracks array

  async function loadArtistTracks(track) {
    const artistId = track?.user?.id;
    const artistName = track?.user?.name || 'This Artist';
    if (!artistId) return;

    // Debounce: don't reload if same artist
    if (artistId === currentArtistId) {
      highlightActiveRow();
      return;
    }
    currentArtistId = artistId;

    // Update header immediately
    const heading = document.getElementById('tracksHeading');
    const header  = document.getElementById('tracksHeader');
    const countEl = document.getElementById('tracksCount');
    const trackListEl = document.getElementById('trackList');

    if (heading) {
      heading.innerHTML = `More From <span style="color:var(--text)">${escHtmlMain(artistName)}</span>`;
    }
    if (countEl) countEl.textContent = 'Loading…';
    if (header) {
      // Add profile link button if not present
      if (!header.querySelector('.artist-profile-link')) {
        const btn = document.createElement('button');
        btn.className = 'artist-profile-link';
        btn.textContent = '↗ PROFILE';
        btn.onclick = () => openArtistDrawer(artistId);
        header.appendChild(btn);
      } else {
        header.querySelector('.artist-profile-link').onclick = () => openArtistDrawer(artistId);
      }
    }

    // Show skeleton while fetching
    if (trackListEl) {
      trackListEl.innerHTML = Array.from({length: 6}).map((_, i) => `
        <div class="skeleton-row" style="animation-delay:${i*40}ms">
          <div class="skel skel-xs"></div>
          <div class="skel skel-sq"></div>
          <div>
            <div class="skel skel-lg"></div>
            <div class="skel skel-sm"></div>
          </div>
          <div class="skel skel-xs"></div>
          <div class="skel skel-xs" style="justify-self:end"></div>
          <div class="skel skel-xs" style="justify-self:end"></div>
        </div>`).join('');
    }

    // Use cache or fetch
    let artistTracks = artistTracksCache[artistId];
    if (!artistTracks) {
      try {
        const r = await fetch(`${BASE}/users/${artistId}/tracks?limit=25&sort=plays`, {
          signal: AbortSignal.timeout(8000)
        });
        if (r.ok) {
          const d = await r.json();
          artistTracks = d.data || [];
          // Sort by play count descending
          artistTracks.sort((a, b) => (b.play_count || 0) - (a.play_count || 0));
          artistTracksCache[artistId] = artistTracks;
        }
      } catch(e) {
        artistTracks = [];
      }
    }

    // If artist changed while we were fetching, bail
    if (currentArtistId !== artistId) return;

    // Update count
    if (countEl) {
      countEl.textContent = artistTracks.length
        ? `${artistTracks.length} TRACKS · ${artistName.toUpperCase()}`
        : 'No tracks found';
    }

    // Render artist tracks into the list
    if (trackListEl) {
      if (!artistTracks.length) {
        trackListEl.innerHTML = `<div style="padding:2rem;font-family:'Rajdhani',sans-serif;font-size:0.75rem;letter-spacing:0.15em;color:var(--muted);text-transform:uppercase;text-align:center;">No tracks available</div>`;
        return;
      }

      trackListEl.innerHTML = artistTracks.map((t, i) => {
        const thumb = t.artwork ? (t.artwork['150x150'] || t.artwork['480x480']) : null;
        const isActive = t.id === track.id;
        // Register in trackRegistry for playback
        trackRegistry[t.id] = t;
        return `<div class="track-row track-row-new ${isActive ? 'active' : ''}" style="animation-delay:${Math.min(i, 12)*25}ms" onclick="playRegisteredTrack('${t.id}')">
          <span class="t-num ${isActive ? '' : ''}">${i+1}</span>
          <div class="t-art">${thumb
            ? `<img src="${thumb}" alt="" loading="lazy" onerror="this.parentElement.textContent='♪'" />`
            : '♪'
          }</div>
          <div class="t-info">
            <div class="t-name">${escHtmlMain(t.title || 'Unknown')}</div>
            <div class="t-artist">${escHtmlMain(t.user?.name || artistName)}</div>
          </div>
          <div class="t-genre">${escHtmlMain(t.genre || '—')}</div>
          <div class="t-plays">${fmt(t.play_count)}</div>
          <div class="t-dur">${fmtTime(t.duration)}</div>
        </div>`;
      }).join('');
    }
  }

  function highlightActiveRow() {
    const track = tracks[currentIndex];
    if (!track) return;
    document.querySelectorAll('#trackList .track-row').forEach(r => {
      r.classList.toggle('active', r.querySelector('.t-name')?.textContent === track.title);
    });
  }

  function escHtmlMain(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }


  // ══════════════════════════════════════════
  // HISTORY / NAVIGATION
  // Views: 'home' | 'search' | 'artist'
  // Each entry: { view, payload }
  // ══════════════════════════════════════════

  const historyStack = [];   // past states
  const futureStack  = [];   // states we can go forward to
  let   currentView  = { view: 'home', payload: null };

  function pushView(view, payload = null) {
    // Don't push if same as current
    if (currentView.view === view &&
        JSON.stringify(currentView.payload) === JSON.stringify(payload)) return;

    historyStack.push(currentView);
    futureStack.length = 0;          // new navigation clears forward history
    currentView = { view, payload };
    _syncNavBtns();
  }

  function navBack() {
    if (!historyStack.length) return;
    futureStack.push(currentView);
    const prev = historyStack.pop();
    currentView = prev;
    _applyView(prev);
    _syncNavBtns();
  }

  function navForward() {
    if (!futureStack.length) return;
    historyStack.push(currentView);
    const next = futureStack.pop();
    currentView = next;
    _applyView(next);
    _syncNavBtns();
  }

  function _applyView(entry) {
    if (entry.view === 'home') {
      // Close everything, stay on main player
      if (searchPanel.classList.contains('open'))  closeSearchSilent();
      if (document.getElementById('profileDrawer').classList.contains('open')) closeDrawerSilent();
      const pp = document.getElementById('playlistPanel');
      if (pp && pp.classList.contains('open')) { pp.classList.remove('open'); document.body.style.overflow = ''; }
    } else if (entry.view === 'playlist') {
      // Re-open panel for this playlist from cache
      if (activePanelPlaylist && activePanelPlaylist.id === entry.payload?.playlistId) {
        document.getElementById('playlistPanel').classList.add('open');
        document.body.style.overflow = 'hidden';
        _renderPanelHero(activePanelPlaylist, panelTrackList);
      }
    } else if (entry.view === 'search') {
      if (document.getElementById('profileDrawer').classList.contains('open')) closeDrawerSilent();
      openSearchPanel();
      if (entry.payload?.query) {
        searchInput.value = entry.payload.query;
        searchClear.classList.add('visible');
        if (entry.payload.results) {
          // Restore cached results
          searchResults = entry.payload.results;
          activeTab = entry.payload.tab || 'all';
          document.querySelectorAll('.search-tab').forEach(t =>
            t.classList.toggle('active', t.dataset.tab === activeTab));
          renderSearchResults();
        } else {
          runSearch(entry.payload.query);
        }
      }
    } else if (entry.view === 'artist') {
      if (searchPanel.classList.contains('open')) openSearchPanel(); // keep search behind
      openArtistDrawerSilent(entry.payload?.userId);
    }
  }

  function _syncNavBtns() {
    const back = document.getElementById('btnBack');
    const fwd  = document.getElementById('btnFwd');
    if (back) back.disabled = historyStack.length === 0;
    if (fwd)  fwd.disabled  = futureStack.length  === 0;
  }

  // ── Silent versions that don't push history ──
  function closeSearchSilent() {
    searchPanel.classList.remove('open');
    document.body.style.overflow = '';
  }

  function closeDrawerSilent() {
    document.getElementById('drawerScrim').classList.remove('open');
    document.getElementById('profileDrawer').classList.remove('open');
  }

  function openArtistDrawerSilent(userId) {
    if (!userId) return;
    const scrim  = document.getElementById('drawerScrim');
    const drawer = document.getElementById('profileDrawer');
    const body   = document.getElementById('drawerBody');
    scrim.classList.add('open');
    drawer.classList.add('open');
    body.innerHTML = `<div class="drawer-loading"><div class="search-spinner"></div></div>`;
    _fetchAndRenderDrawer(userId);
  }

  // ── Go home ──
  function goHome() {
    pushView('home');
    closeSearchSilent();
    closeDrawerSilent();
    searchInput.value = '';
    searchClear.classList.remove('visible');
    searchResults = { tracks: [], artists: [], albums: [], playlists: [] };
    document.querySelectorAll('.search-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === 'all'));
  }

  // Keyboard shortcut: Alt+Left / Alt+Right for back/forward
  document.addEventListener('keydown', e => {
    if (e.altKey && e.key === 'ArrowLeft')  { e.preventDefault(); navBack(); }
    if (e.altKey && e.key === 'ArrowRight') { e.preventDefault(); navForward(); }
  });


  // ══════════════════════════════════════════
  // NATIVE PLAYLIST / ALBUM PANEL
  // ══════════════════════════════════════════
  let activePanelPlaylist = null; // the playlist/album object currently shown
  let panelTrackList = [];        // resolved tracks for the panel

  async function openPlaylistPanel(playlistObj) {
    if (!playlistObj) return;
    activePanelPlaylist = playlistObj;
    panelTrackList = [];

    const isAlbum = playlistObj.is_album;
    pushView('playlist', { playlistId: playlistObj.id, isAlbum });

    const panel = document.getElementById('playlistPanel');
    const body  = document.getElementById('plPanelBody');
    const title = document.getElementById('plPanelTitle');

    title.textContent = isAlbum ? 'Album' : 'Playlist';
    panel.classList.add('open');
    document.body.style.overflow = 'hidden';

    // Render hero immediately with what we have
    _renderPanelHero(playlistObj, []);

    // Fetch full track list
    try {
      const r = await fetch(`${SEARCH_BASE}/playlists/${playlistObj.id}/tracks`, {
        signal: AbortSignal.timeout(10000)
      });
      if (r.ok) {
        const d = await r.json();
        panelTrackList = d.data || [];
      }
    } catch(e) {}

    // Re-render with tracks
    _renderPanelHero(playlistObj, panelTrackList);
  }

  function _renderPanelHero(p, trackList) {
    const body = document.getElementById('plPanelBody');
    if (!body) return;
    const isAlbum = p.is_album;
    const art = p.artwork ? (p.artwork['480x480'] || p.artwork['1000x1000'] || p.artwork['150x150']) : null;
    const trackCount = trackList.length || p.playlist_contents?.track_ids?.length || p.track_count || 0;
    const totalDuration = trackList.reduce((s, t) => s + (t.duration || 0), 0);

    let html = `
      <div class="pl-hero">
        <div class="pl-cover">
          ${art ? `<img src="${art}" alt="" onerror="this.parentElement.innerHTML='${isAlbum ? '💿' : '♫'}'" />` : (isAlbum ? '💿' : '♫')}
        </div>
        <div class="pl-meta">
          <div class="pl-type-badge">${isAlbum ? 'Album' : 'Playlist'}</div>
          <div class="pl-title">${escHtmlMain(p.playlist_name || p.name || 'Unknown')}</div>
          <div class="pl-artist-line" onclick="openArtistDrawer('${p.user?.id}')">
            ${escHtmlMain(p.user?.name || '—')} <span style="font-size:0.75em;opacity:0.5;">›</span>
          </div>
          <div class="pl-stats-row">
            ${trackCount ? `<div class="pl-stat"><div class="pl-stat-val">${trackCount}</div><div class="pl-stat-label">Tracks</div></div>` : ''}
            ${totalDuration ? `<div class="pl-stat"><div class="pl-stat-val">${fmtTime(totalDuration)}</div><div class="pl-stat-label">Duration</div></div>` : ''}
            ${p.favorite_count ? `<div class="pl-stat"><div class="pl-stat-val">${fmtNum(p.favorite_count)}</div><div class="pl-stat-label">Favorites</div></div>` : ''}
            ${p.repost_count ? `<div class="pl-stat"><div class="pl-stat-val">${fmtNum(p.repost_count)}</div><div class="pl-stat-label">Reposts</div></div>` : ''}
          </div>
          <div class="pl-actions">
            ${trackList.length ? `<button class="pl-btn-play" onclick="playPanelFromStart()">▶ PLAY ALL</button>` : '<button class="pl-btn-play" disabled style="opacity:0.3">Loading…</button>'}
            <button class="pl-btn-artist" onclick="openArtistDrawer('${p.user?.id}')">↗ ARTIST</button>
          </div>
        </div>
      </div>
    `;

    if (!trackList.length) {
      html += `<div class="pl-loading"><div class="search-spinner"></div><div style="font-family:'Rajdhani',sans-serif;font-size:0.72rem;letter-spacing:0.15em;color:var(--muted);">Loading tracks…</div></div>`;
    } else {
      html += `
        <div class="pl-track-list">
          <div class="pl-track-col-headers">
            <span class="pl-col-h">#</span>
            <span class="pl-col-h"></span>
            <span class="pl-col-h">Title</span>
            <span class="pl-col-h right">Plays</span>
            <span class="pl-col-h right">Time</span>
          </div>
          ${trackList.map((t, i) => {
            const thumb = t.artwork ? (t.artwork['150x150'] || t.artwork['480x480']) : null;
            trackRegistry[t.id] = t;
            return `<div class="pl-track-row" id="plrow_${t.id}" onclick="playPanelTrack(${i})">
              <span class="pl-t-num">${i + 1}</span>
              <div class="pl-t-art">${thumb ? `<img src="${thumb}" loading="lazy" onerror="this.parentElement.textContent='♪'" />` : '♪'}</div>
              <div class="pl-t-info">
                <div class="pl-t-name">${escHtmlMain(t.title || 'Unknown')}</div>
                <div class="pl-t-artist">${escHtmlMain(t.user?.name || p.user?.name || '—')}</div>
              </div>
              <div class="pl-t-plays">${t.play_count ? fmtNum(t.play_count) : '—'}</div>
              <div class="pl-t-dur">${fmtTime(t.duration)}</div>
            </div>`;
          }).join('')}
        </div>
      `;
    }

    body.innerHTML = html;
    _updatePanelActiveRow();
  }

  function playPanelFromStart() {
    if (!panelTrackList.length) return;
    playPanelTrack(0);
  }

  function playPanelTrack(idx) {
    if (idx < 0 || idx >= panelTrackList.length) return;
    const t = panelTrackList[idx];
    trackRegistry[t.id] = t;

    // Insert entire panel track list into the global queue at front
    // so NEXT button navigates within the playlist
    const ids = new Set(panelTrackList.map(x => x.id));
    tracks = tracks.filter(x => !ids.has(x.id));
    tracks.unshift(...panelTrackList);

    const globalIdx = idx;
    currentIndex = globalIdx;
    currentArtistId = null; // reset so artist suggestion logic doesn't override

    updateHeroInfo(t);
    audio.src = `${BASE}/tracks/${t.id}/stream`;
    audio.play().then(() => { isPlaying = true; updatePlayBtn(); }).catch(() => { isPlaying = false; updatePlayBtn(); });

    // Update panel row highlighting
    _updatePanelActiveRow(t.id);
  }

  function _updatePanelActiveRow(activeId) {
    document.querySelectorAll('.pl-track-row').forEach(r => r.classList.remove('active'));
    const cur = activeId || (tracks[currentIndex] ? tracks[currentIndex].id : null);
    if (cur) {
      const row = document.getElementById('plrow_' + cur);
      if (row) row.classList.add('active');
    }
  }

  function closePlaylistPanel() {
    document.getElementById('playlistPanel').classList.remove('open');
    document.body.style.overflow = '';
    if (currentView.view === 'playlist') {
      if (historyStack.length) navBack();
      else pushView('home');
    }
  }

  // Register 'playlist' as a known view in _applyView
  const _origApplyView = window._applyView;

</script>


  .playlist-owner {
    font-size: 0.7rem;
    color: var(--muted2);
    margin-bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .playlist-track-count {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.55rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .album-badge {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.55rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 1px 4px;
    border: 1px solid var(--border2);

    searchTimer = setTimeout(() => runSearch(q), 300);
  });

  searchInput.addEventListener('keydown', e => {
    if (e.key === 'Escape') clearSearch();
  });

  function clearSearch() {
    searchInput.value = '';
    searchClear.classList.remove('visible');

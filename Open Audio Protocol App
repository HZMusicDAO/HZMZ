    if (currentView.view === 'search') pushView('home');
  }

  // ── Tab switching ──
  document.getElementById('searchTabs').addEventListener('click', e => {
    const tab = e.target.closest('.search-tab');
    if (!tab) return;
    activeTab = tab.dataset.tab;
    document.querySelectorAll('.search-tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    if (currentView.view === 'search' && currentView.payload) currentView.payload.tab = activeTab;
    renderSearchResults();
  });

  // ── Core search ──
  async function runSearch(q) {
    if (q === lastQuery && !searchPending) return;
    lastQuery = q;
    searchPending = true;

    resultsArea.innerHTML = `<div class="search-empty"><div class="search-spinner"></div><div class="search-empty-text">Searching…</div></div>`;

    // Reset counts
    ['Tracks','Artists','Albums','Playlists'].forEach(k => {
      const el = document.getElementById('cnt' + k);
      if (el) el.textContent = '';
    });

    const enc = encodeURIComponent(q);

    // Fire searches in parallel.
    // NOTE: The Audius REST API has no /albums/search endpoint.
    // Albums are playlists with is_album=true, so we:
    //   1) Search playlists and filter by is_album for title matches
    //   2) Search users by the same query and fetch each matched user's albums
    //      — this is what surfaces "God Sent Genius"'s albums when you type their name
    const [tracksRes, artistsRes, playlistsRes] = await Promise.allSettled([
      apiFetch(`${SEARCH_BASE}/tracks/search?query=${enc}&limit=25`),
      apiFetch(`${SEARCH_BASE}/users/search?query=${enc}&limit=10`),
      apiFetch(`${SEARCH_BASE}/playlists/search?query=${enc}&limit=50`),
    ]);

    const tracks         = tracksRes.status    === 'fulfilled' ? (tracksRes.value?.data    || []) : [];
    const matchedArtists = artistsRes.status   === 'fulfilled' ? (artistsRes.value?.data   || []) : [];
    const allPlaylists   = playlistsRes.status === 'fulfilled' ? (playlistsRes.value?.data || []) : [];

    // Separate playlists from albums (title-match albums only)
    const titleMatchAlbums = allPlaylists.filter(p => p.is_album);
    const playlists        = allPlaylists.filter(p => !p.is_album);

    // For every matched artist, fetch their full album catalog in parallel
    const artistAlbumFetches = matchedArtists.slice(0, 5).map(a =>
      apiFetch(`${SEARCH_BASE}/users/${a.id}/albums?limit=50`)
        .then(r => r.data || [])
        .catch(() => [])
    );
    const artistAlbumArrays = await Promise.all(artistAlbumFetches);
    const artistAlbums = artistAlbumArrays.flat();

    // Merge: artist catalog albums first (most relevant when searching by name),
    // then title-match albums, deduplicating by id
    const seenAlbumIds = new Set();
    const albums = [];
    for (const a of [...artistAlbums, ...titleMatchAlbums]) {
      if (!seenAlbumIds.has(a.id)) {
        seenAlbumIds.add(a.id);
        albums.push(a);
      }
    }

    // artists for the Artists tab = matched artists from user search
    const artists = matchedArtists;

    searchResults = { tracks, artists, albums, playlists };
    searchPending = false;
    // Update current history entry with results so back/forward can restore them
    if (currentView.view === 'search') {
      currentView.payload = {
        query: q,
        tab: activeTab,
        results: { tracks, artists, albums, playlists }
      };
    }

    // Update tab counts
    const setCnt = (id, n) => { const el = document.getElementById(id); if (el) el.textContent = n > 0 ? n : ''; };
    setCnt('cntTracks',    tracks.length);
    setCnt('cntArtists',   artists.length);
    setCnt('cntAlbums',    albums.length);
    setCnt('cntPlaylists', playlists.length);

    renderSearchResults();
  }

  async function apiFetch(url) {
    const r = await fetch(url, { signal: AbortSignal.timeout(8000) });
    if (!r.ok) throw new Error(r.status);
    return r.json();
  }

  // ── Render results by active tab ──
  function renderSearchResults() {
    const { tracks, artists, albums, playlists } = searchResults;
    const total = tracks.length + artists.length + albums.length + playlists.length;

    if (total === 0 && !searchPending) {
      resultsArea.innerHTML = `<div class="search-empty"><div class="search-empty-icon">⊘</div><div class="search-empty-text">No results for "${lastQuery}"</div></div>`;
      return;
    }

    let html = '';

    const showTracks    = activeTab === 'all' || activeTab === 'tracks';
    const showArtists   = activeTab === 'all' || activeTab === 'artists';
    const showAlbums    = activeTab === 'all' || activeTab === 'albums';
    const showPlaylists = activeTab === 'all' || activeTab === 'playlists';

    // TRACKS
    if (showTracks && tracks.length) {
      html += `<div class="results-section-header">

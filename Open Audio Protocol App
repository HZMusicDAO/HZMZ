  }

  .wallet-icon {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .wallet-name {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text);
  }

  .wallet-sub {
    font-size: 0.7rem;
    color: var(--muted2);
    margin-top: 1px;
  }

  .wallet-arrow {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .input-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .stake-input {
    flex: 1;
    background: var(--surface2);
    border: 1px solid var(--border2);
    color: var(--text);
    padding: 0.65rem 0.9rem;
    font-family: 'Orbitron', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    outline: none;
    transition: border-color 0.15s;
  }
  .stake-input:focus { border-color: var(--muted2); }
  .stake-input::placeholder { color: var(--muted); }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .info-row:last-child { border-bottom: none; }
  .info-row-label {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted2);
  }
  .info-row-val {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.65rem;
    color: var(--muted3);
  }

  .network-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: var(--surface3);
    border: 1px solid var(--border2);
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--muted2);
  }
  .network-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #4ade80;
    animation: blink 2s ease-in-out infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

  /* Wallet connect button in header */
  .btn-wallet {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 0.9rem;
    background: transparent;
    border: 1px solid var(--border2);
    color: var(--muted2);
    cursor: pointer;
    transition: all 0.18s;
    border-radius: 1px;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .btn-wallet:hover { border-color: var(--muted2); color: var(--text); }
  .btn-wallet.connected { border-color: rgba(74,222,128,0.4); color: #4ade80; }
  .btn-wallet-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #4ade80;
  }


  /* ── SEARCH BAR ── */
  .search-wrap {
    position: relative;
    flex: 1;
    max-width: 340px;
    min-width: 140px;
  }

  .search-input {
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border2);
    color: var(--text);
    padding: 0.42rem 2.4rem 0.42rem 2.2rem;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    outline: none;
    transition: border-color 0.18s, background 0.18s;
    border-radius: 1px;
    height: 36px;
  }

  .search-input:focus {
    border-color: var(--muted2);
    background: var(--surface3);
  }

  .search-input::placeholder {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .search-icon {
    position: absolute;
    left: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    font-size: 0.75rem;
    pointer-events: none;
    line-height: 1;
  }

  .search-clear {
    position: absolute;
    right: 0.55rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.7rem;
    padding: 0.1rem;
    line-height: 1;
    display: none;
    transition: color 0.15s;
  }

  .search-clear:hover { color: var(--muted3); }
  .search-clear.visible { display: block; }

  /* ── SEARCH OVERLAY PANEL ── */
  .search-panel {
    display: none;
    position: fixed;
    top: 64px; /* below header */
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg);
    z-index: 150;
    flex-direction: column;
    overflow: hidden;
    animation: fadeIn 0.18s ease;
  }

  .search-panel.open { display: flex; }

  /* tab bar */
  .search-tabs {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0 2rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .search-tabs::-webkit-scrollbar { display: none; }

  .search-tab {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.9rem 1.4rem;
    cursor: pointer;
    color: var(--muted2);
    border: none;
    background: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
    position: relative;
    top: 1px;
  }

  .search-tab:hover { color: var(--muted3); }

  .search-tab.active {
    color: var(--text);
    border-bottom-color: var(--text);
  }

  .search-tab .tab-count {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    margin-left: 0.35rem;
    color: var(--muted);
  }

  .search-tab.active .tab-count { color: var(--muted2); }

  /* results area */
  .search-results-area {
    flex: 1;
    overflow-y: auto;
    padding: 0 0 2rem;
  }

  .search-results-area::-webkit-scrollbar { width: 4px; }
  .search-results-area::-webkit-scrollbar-track { background: transparent; }
  .search-results-area::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }

  /* empty/loading states inside panel */
  .search-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 300px;
    color: var(--muted);
  }

  .search-empty-icon {
    font-size: 2.5rem;
    opacity: 0.3;
  }

  .search-empty-text {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .search-spinner {
    width: 28px;
    height: 28px;
    border: 2px solid var(--border2);
    border-top-color: var(--muted2);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* section heading inside results */
  .results-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 2rem 0.6rem;
    position: sticky;
    top: 0;
    background: rgba(0,0,0,0.95);
    z-index: 2;
    backdrop-filter: blur(8px);
  }

  .results-section-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted2);
  }

  .results-section-count {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  /* ── TRACK RESULT ROW ── */
  .result-track {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.65rem 2rem;
    cursor: pointer;
    transition: background 0.15s;
    border-bottom: 1px solid transparent;
  }

  .result-track:hover {
    background: var(--surface);
    border-bottom-color: var(--border);
  }

  .result-track:hover .result-play-btn { opacity: 1; }

  .result-art {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    background: var(--surface3);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    position: relative;
  }

  .result-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .result-play-btn {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.6);

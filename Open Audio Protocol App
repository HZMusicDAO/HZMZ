  // ══════════════════════════════════════════
  // SEARCH ENGINE — Audius API
  // ══════════════════════════════════════════
  const SEARCH_BASE = 'https://api.audius.co/v1';
  let searchTimer = null;
  let lastQuery = '';
  let activeTab = 'all';
  let searchResults = { tracks: [], artists: [], albums: [], playlists: [] };
  let searchPending = false;

  // Registry: id → track object, avoids passing JSON through onclick attributes
  const trackRegistry = {};

  function playRegisteredTrack(id) {

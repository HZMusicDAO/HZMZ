<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HZ MUSIC — Open Audio Protocol</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&family=Orbitron:wght@400;700;900&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #000000;
    --surface: #0a0a0a;
    --surface2: #111111;
    --surface3: #181818;
    --border: #1e1e1e;
    --border2: #2a2a2a;
    --accent: #ffffff;
    --accent-dim: rgba(255,255,255,0.12);
    --accent-glow: rgba(255,255,255,0.06);
    --text: #f5f5f5;
    --muted: #444;
    --muted2: #777;
    --muted3: #aaa;
    --globe: rgba(200,200,200,0.15);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Subtle grid background */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }

  /* ── HEADER ── */
  header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: rgba(0,0,0,0.88);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    padding: 0 2rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-img {
    height: 38px;
    width: 38px;
    object-fit: contain;
    filter: brightness(1.1);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--text);
  }

  .logo-tagline {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted2);
    margin-top: 2px;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pill {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border2);
    border-radius: 2px;
    cursor: pointer;
    color: var(--muted2);
    background: transparent;
    transition: all 0.18s;
    white-space: nowrap;
  }

  .pill:hover {
    border-color: var(--muted);
    color: var(--muted3);
    background: var(--accent-glow);
  }

  .pill.active {
    border-color: rgba(255,255,255,0.4);
    color: var(--text);
    background: var(--accent-dim);
  }

  /* ── NOW PLAYING HERO ── */
  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 300px 1fr;
    min-height: 300px;
    border-bottom: 1px solid var(--border);
    opacity: 0;
    animation: fadeIn 0.7s ease forwards 0.1s;
  }

  .hero-art {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    flex-shrink: 0;
  }

  .hero-art img.artwork {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease, opacity 0.4s;
  }

  .hero-art-placeholder {
    width: 100%;
    height: 100%;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
  }

  .hero-art-placeholder .globe-logo {
    width: 140px;
    height: 140px;
    opacity: 0.15;
    object-fit: contain;
  }

  /* right-edge fade */
  .hero-art::after {
    content: '';
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 120px;
    background: linear-gradient(90deg, transparent, var(--bg));
  }

  .hero-info {
    padding: 2.5rem 3rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  /* globe watermark behind info */
  .hero-globe-bg {
    position: absolute;
    right: -60px;
    top: 50%;
    transform: translateY(-50%);
    width: 380px;
    height: 380px;
    opacity: 0.04;
    pointer-events: none;
    object-fit: contain;
  }

  .np-eyebrow {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted2);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .np-eyebrow::before {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1px;
    background: var(--muted);
  }

  .np-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.03em;
    color: var(--text);
    margin-bottom: 0.5rem;
    transition: all 0.4s ease;
  }

  .np-artist {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--muted3);
    margin-bottom: 1.8rem;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
  }

  .np-stats {
    display: flex;
    gap: 2.5rem;
    margin-bottom: 2rem;
  }

  .np-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .np-stat-label {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.58rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .np-stat-val {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.8rem;
    color: var(--muted3);
    letter-spacing: 0.05em;
  }

  .np-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--text);
    color: var(--bg);
    border: none;
    padding: 0.7rem 1.6rem;
    font-family: 'Orbitron', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
    border-radius: 1px;
  }

  .btn-primary:hover {
    background: #e0e0e0;
    transform: translateY(-1px);
  }

  .btn-primary.playing {
    background: var(--muted3);
  }

  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border2);
    color: var(--muted2);
    padding: 0.7rem 1.2rem;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
    border-radius: 1px;
  }

  .btn-ghost:hover {
    border-color: var(--muted2);
    color: var(--muted3);
  }

  /* Progress bar */
  .progress-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.2rem;
  }

  .progress-track {
    flex: 1;
    height: 1px;
    background: var(--border2);
    cursor: pointer;
    position: relative;
    transition: height 0.15s;
  }

  .progress-track:hover { height: 2px; }

  .progress-fill {
    height: 100%;
    background: var(--text);
    width: 0%;
    transition: width 0.5s linear;
    position: relative;
  }

  .progress-fill::after {
    content: '';
    position: absolute;
    right: -3px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    background: var(--text);
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .progress-track:hover .progress-fill::after { opacity: 1; }

  .time-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.55rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  /* playing animation */
  .bars-anim {
    display: flex;
    gap: 2px;
    align-items: flex-end;
    height: 12px;
  }

  .bar {
    width: 3px;
    border-radius: 1px;
    background: var(--bg);
    animation: barUp 0.7s ease-in-out infinite;
  }
  .bar:nth-child(1) { height: 5px; animation-delay: 0s; }
  .bar:nth-child(2) { height: 10px; animation-delay: 0.18s; }
  .bar:nth-child(3) { height: 6px; animation-delay: 0.36s; }

  @keyframes barUp {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }

  /* ── TRACK LIST ── */
  .tracks-section {
    position: relative;
    z-index: 1;
    opacity: 0;
    animation: fadeIn 0.7s ease forwards 0.35s;
  }

  .tracks-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .tracks-heading {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--muted3);
    text-transform: uppercase;
  }

  .tracks-count {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--muted);
  }

  /* column headers */
  .col-headers {
    display: grid;
    grid-template-columns: 42px 52px 1fr 100px 80px 60px;
    padding: 0.6rem 2rem;
    border-bottom: 1px solid var(--border);
    gap: 0.5rem;
  }

  .col-h {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .col-h.right { text-align: right; }

  .track-row {
    display: grid;
    grid-template-columns: 42px 52px 1fr 100px 80px 60px;
    align-items: center;
    padding: 0.6rem 2rem;
    gap: 0.5rem;
    cursor: pointer;
    border-bottom: 1px solid transparent;
    transition: background 0.15s;
    position: relative;
  }

  .track-row:hover {
    background: var(--surface);
    border-bottom-color: var(--border);
  }

  .track-row.active {
    background: var(--surface2);
    border-bottom-color: var(--border);
  }

  .track-row.active::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--text);
  }

  .t-num {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.6rem;
    color: var(--muted);
    text-align: right;
  }

  .track-row.active .t-num { color: var(--text); }

  .t-art {
    width: 40px;
    height: 40px;
    background: var(--surface3);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1rem;
  }

  .t-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .t-info { min-width: 0; }

  .t-name {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
    letter-spacing: 0.03em;
  }

  .t-artist {
    font-size: 0.72rem;
    color: var(--muted2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.01em;
  }

  .t-genre {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--muted2);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .t-plays {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.62rem;
    color: var(--muted2);
    text-align: right;
  }

  .t-dur {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.62rem;
    color: var(--muted);
    text-align: right;
  }

  /* ── LOADING ── */
  .loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .loading-logo {
    width: 90px;
    height: 90px;
    object-fit: contain;
    opacity: 0.6;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.4; transform: scale(0.97); }
    50% { opacity: 0.8; transform: scale(1.03); }
  }

  .loading-text {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── ERROR ── */
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    gap: 1.5rem;
    padding: 2rem;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .error-logo {
    width: 100px;
    height: 100px;
    object-fit: contain;
    opacity: 0.2;
  }

  .error-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--muted3);
  }

  .error-msg {
    font-size: 0.8rem;
    color: var(--muted2);
    max-width: 420px;
    line-height: 1.7;
  }

  .error-msg code {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.7em;
    color: var(--muted3);
  }

  .error-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ── FOOTER ── */
  footer {
    position: relative;
    z-index: 1;
    padding: 1.5rem 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .footer-logo img {
    height: 22px;
    width: 22px;
    object-fit: contain;
    opacity: 0.5;
  }

  .footer-logo span {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }

  footer a {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  footer a:hover { color: var(--muted3); }

  .footer-right {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    color: var(--muted);
    text-transform: uppercase;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; }
    .hero-art { height: 220px; }
    .hero-art::after { background: linear-gradient(0deg, var(--bg) 10%, transparent); }
    .hero-info { padding: 1.5rem; }
    .col-headers, .track-row { grid-template-columns: 36px 44px 1fr 70px; }
    .t-genre, .t-dur { display: none; }
    .header-nav { display: none; }
    footer { flex-direction: column; gap: 1rem; text-align: center; }
  }

  /* ── TOKEN PANEL ── */
  .token-bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    height: 44px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    gap: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .token-bar::-webkit-scrollbar { display: none; }

  .token-ticker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .ticker-symbol {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text);
  }
  .ticker-price {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.68rem;
    color: var(--muted3);
  }
  .ticker-change {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 2px;
  }
  .ticker-change.up   { color: #4ade80; background: rgba(74,222,128,0.08); }
  .ticker-change.down { color: #f87171; background: rgba(248,113,113,0.08); }

  .token-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-shrink: 0;
  }
  .t-stat {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .t-stat-label {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .t-stat-val {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.6rem;
    color: var(--muted2);
  }
  .token-divider {
    width: 1px;
    height: 20px;
    background: var(--border2);
    flex-shrink: 0;
  }
  .token-actions {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .btn-token {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.8rem;
    border-radius: 1px;
    cursor: pointer;
    transition: all 0.18s;
    white-space: nowrap;
  }
  .btn-token.primary {
    background: var(--text);
    color: var(--bg);
    border: 1px solid var(--text);
  }
  .btn-token.primary:hover { background: #ddd; }
  .btn-token.ghost {
    background: transparent;
    color: var(--muted2);
    border: 1px solid var(--border2);
  }
  .btn-token.ghost:hover { border-color: var(--muted2); color: var(--muted3); }

  /* ── WALLET MODAL ── */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 500;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .modal-overlay.open { display: flex; }

  .modal {
    background: var(--surface);
    border: 1px solid var(--border2);
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    animation: fadeIn 0.2s ease;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .modal-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text);
  }

  .modal-close {
    background: none;
    border: none;
    color: var(--muted2);
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0.2rem;
    transition: color 0.15s;
    line-height: 1;
  }
  .modal-close:hover { color: var(--text); }

  .modal-body { padding: 1.5rem; }

  .modal-section {
    margin-bottom: 1.75rem;
  }

  .modal-section:last-child { margin-bottom: 0; }

  .modal-section-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .contract-box {
    background: var(--surface2);
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border-radius: 1px;
  }

  .contract-addr {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.58rem;
    color: var(--muted3);
    letter-spacing: 0.04em;
    word-break: break-all;

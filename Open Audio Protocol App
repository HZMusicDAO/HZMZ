    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.7rem;
  }

  .result-artist:hover { background: var(--surface); }

  .artist-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .artist-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artist-name {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.03em;
    line-height: 1.2;
  }

  .artist-followers {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.55rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .artist-track-count {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.65rem;
    color: var(--muted2);
    letter-spacing: 0.05em;

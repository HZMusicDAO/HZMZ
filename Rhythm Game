<script>
/**
 * SOLANA BEATS - LOGIC
 * Includes: Audio Synthesis, Game Loop, Hit Detection, Fake Wallet Integration
 */

// --- CONFIGURATION ---
const LANE_COUNT = 4;
const KEY_MAPPING = ['KeyD', 'KeyF', 'KeyJ', 'KeyK'];
const HIT_ZONE_Y_PERCENT = 0.85; // Percentage down the screen
const NOTE_SPEED = 600; // Pixels per second (adjusted dynamically based on screen height)
const AUDIO_BPM = 128;

// --- STATE MANAGEMENT ---
const state = {
    isPlaying: false,
    startTime: 0,
    score: 0,
    combo: 0,
    maxCombo: 0,
    multiplier: 1,
    perfects: 0,
    goods: 0,
    misses: 0,
    walletConnected: false,
    walletAddress: null,
    hzmzBalance: 0,
    notes: [], // Active notes
    mapIndex: 0 // Current position in song map
};

// --- AUDIO ENGINE (Web Audio API) ---
// We synthesize music to ensure no external dependency issues
const AudioEngine = {
    ctx: null,
    masterGain: null,
    nextNoteTime: 0,
    scheduleAheadTime: 0.1,
    lookahead: 25,
    timerID: null,
    beatCount: 0,

    init() {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        this.ctx = new AudioContext();
        this.masterGain = this.ctx.createGain();
        this.masterGain.gain.value = 0.4;
        this.masterGain.connect(this.ctx.destination);
    },

    playTone(freq, type = 'sine', duration = 0.1, time = 0) {
        if (!this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.value = freq;
        osc.connect(gain);
        gain.connect(this.masterGain);
        
        const now = time || this.ctx.currentTime;
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
        
        osc.start(now);
        osc.stop(now + duration);
    },

    playKick(time) {
        if (!this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.frequency.setValueAtTime(150, time);
        osc.frequency.exponentialRampToValueAtTime(0.001, time + 0.5);
        gain.gain.setValueAtTime(0.8, time);
        gain.gain.exponentialRampToValueAtTime(0.001, time + 0.5);
        osc.connect(gain);
        gain.connect(this.masterGain);
        osc.start(time);
        osc.stop(time + 0.5);
    },

    playHiHat(time) {
        // Simple noise burst simulation
        // (Simplified for brevity, using high freq osc)
        this.playTone(800, 'square', 0.05, time); 
    },

    playHitSound() {
        this.playTone(1200, 'triangle', 0.1);
    },

    scheduler() {
        // While there are notes that will need to play before the next interval, 
        // schedule them and advance the pointer.
        while (this.nextNoteTime < this.ctx.currentTime + this.scheduleAheadTime) {
            this.scheduleNote(this.beatCount, this.nextNoteTime);
            this.nextNote();
        }
        this.timerID = setTimeout(() => this.scheduler(), this.lookahead);
    },

    nextNote() {
        const secondsPerBeat = 60.0 / AUDIO_BPM;
        this.nextNoteTime += secondsPerBeat / 4; // 16th notes
        this.beatCount++;
    },

    scheduleNote(beatNumber, time) {
        // Basic Techno Pattern
        // Kick on 1, 5, 9, 13 (quarter notes)
        if (beatNumber % 4 === 0) {
            this.playKick(time);
        }
        // Off-beat hats
        if (beatNumber % 4 === 2) {
            this.playHiHat(time);
        }
        
        // Bassline logic matching the notes generated below
        if (state.isPlaying) {
             // Generate game notes based on music rhythm
             // We map the beat to lanes pseudo-randomly but deterministically
             if (beatNumber % 2 === 0 && Math.random() > 0.3) {
                 const lane = Math.floor(Math.random() * LANE_COUNT);
                 spawnNote(lane);
             }
        }
    },

    start() {
        if (this.ctx.state === 'suspended') this.ctx.resume();
        this.beatCount = 0;
        this.nextNoteTime = this.ctx.currentTime + 0.1;
        this.scheduler();
    },

    stop() {
        clearTimeout(this.timerID);
    }
};

// --- GAME LOGIC ---
const canvas = document.getElementById('game-canvas');
const ctx = canvas.getContext('2d');
let animationFrameId;

function resizeCanvas() {
    canvas.width = canvas.clientWidth;
    canvas.height = canvas.clientHeight;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

class Note {
    constructor(lane) {
        this.lane = lane;
        this.y = -50; // Start above screen
        this.hit = false;
        this.missed = false;
        this.speed = canvas.height / 2; // Pixel speed relative to height
        this.timestamp = Date.now();
    }

    update(dt) {
        // Normalize speed
        this.y += this.speed * dt;
    }

    draw(ctx) {
        if (this.hit) return;

        const laneWidth = canvas.width / LANE_COUNT;
        const x = this.lane * laneWidth;
        const width = laneWidth;
        const height = 20;

        // Note Body
        ctx.fillStyle = this.missed ? '#555' : '#d8b4fe';
        ctx.shadowColor = '#a855f7';
        ctx.shadowBlur = 10;
        
        // Draw Note Rectangle
        ctx.fillRect(x + 5, this.y, width - 10, height);
        
        // Inner highlight
        ctx.fillStyle = '#fff';
        ctx.fillRect(x + 10, this.y + 5, width - 20, height - 10);
        
        ctx.shadowBlur = 0; // Reset
    }
}

function spawnNote(lane) {
    state.notes.push(new Note(lane));
}

function gameLoop() {
    const now = Date.now();
    const dt = (now - (state.lastFrameTime || now)) / 1000;
    state.lastFrameTime = now;

    // Clear
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Draw Lanes
    const laneWidth = canvas.width / LANE_COUNT;
    ctx.strokeStyle = 'rgba(168, 85, 247, 0.2)';
    ctx.lineWidth = 2;
    for (let i = 1; i < LANE_COUNT; i++) {
        ctx.beginPath();
        ctx.moveTo(i * laneWidth, 0);
        ctx.lineTo(i * laneWidth, canvas.height);
        ctx.stroke();
    }

    // Draw Hit Zone
    const hitY = canvas.height * HIT_ZONE_Y_PERCENT;
    ctx.fillStyle = 'rgba(168, 85, 247, 0.1)';
    ctx.fillRect(0, hitY, canvas.width, 20);
    ctx.strokeStyle = '#a855f7';
    ctx.beginPath();
    ctx.moveTo(0, hitY + 10);
    ctx.lineTo(canvas.width, hitY + 10);
    ctx.stroke();
    
    // Key hints
    ctx.font = '20px Orbitron';
    ctx.fillStyle = '#fff';
    ctx.textAlign = 'center';
    const keys = ['D', 'F', 'J', 'K'];
    for(let i=0; i<4; i++) {
        ctx.fillText(keys[i], (i * laneWidth) + (laneWidth/2), canvas.height - 20);
    }

    // Update and Draw Notes
    for (let i = state.notes.length - 1; i >= 0; i--) {
        const note = state.notes[i];
        note.update(dt);
        note.draw(ctx);

        // Miss detection
        if (!note.hit && !note.missed && note.y > canvas.height) {
            note.missed = true;
            registerHit('miss');
            state.notes.splice(i, 1);
        }
    }

    if (state.isPlaying) {
        animationFrameId = requestAnimationFrame(gameLoop);
    }
}

// --- INPUT HANDLING ---
function handleInput(lane) {
    if (!state.isPlaying) return;

    // Visual feedback for lane press
    const laneWidth = canvas.width / LANE_COUNT;
    const x = lane * laneWidth;
    const hitY = canvas.height * HIT_ZONE_Y_PERCENT;
    
    // Create a flash effect (simple rect for now, could be improved)
    const flash = document.createElement('div');
    flash.style.position = 'absolute';
    flash.style.left = `${(lane * 25)}%`;
    flash.style.bottom = '0';
    flash.style.width = '25%';
    flash.style.height = '20%';
    flash.style.background = 'linear-gradient(to top, rgba(255,255,255,0.3), transparent)';
    flash.style.pointerEvents = 'none';
    document.body.appendChild(flash);
    setTimeout(() => flash.remove(), 100);

    // Find closest note in this lane
    const hitYVal = canvas.height * HIT_ZONE_Y_PERCENT;
    // Look for notes within a reasonable window relative to hit line
    // Window is roughly +/- 60 pixels
    const hitWindow = 80;
    
    let hitNoteIndex = -1;
    let minDiff = Infinity;

    for (let i = 0; i < state.notes.length; i++) {
        const note = state.notes[i];
        if (note.lane === lane && !note.hit && !note.missed) {
            const diff = Math.abs(note.y - hitYVal);
            if (diff < hitWindow && diff < minDiff) {
                minDiff = diff;
                hitNoteIndex = i;
            }
        }
    }

    if (hitNoteIndex !== -1) {
        const note = state.notes[hitNoteIndex];
        note.hit = true;
        state.notes.splice(hitNoteIndex, 1); // Remove immediately

        // Judge accuracy
        if (minDiff < 20) registerHit('perfect');
        else registerHit('good');
        
        AudioEngine.playHitSound();
    } else {
        // Hit nothing (ghost tap) - usually rhythm games ignore or penalize
        // We'll ignore for casual play
    }
}

function registerHit(quality) {
    const scoreEl = document.getElementById('score');
    const comboEl = document.getElementById('combo');
    const multEl = document.getElementById('multiplier');
    const feedbackContainer = document.getElementById('feedback-container');

    // Create floating text
    const float = document.createElement('div');
    float.className = 'absolute transform -translate-x-1/2 transition-all duration-500 ease-out';
    float.style.left = '50%';
    float.style.top = '0';
    
    if (quality === 'perfect') {
        state.score += 100 * state.multiplier;
        state.combo++;
        state.perfects++;
        float.innerText = 'PERFECT';
        float.className += ' hit-perfect';
    } else if (quality === 'good') {
        state.score += 50 * state.multiplier;
        state.combo++;
        state.goods++;
        float.innerText = 'GOOD';
        float.className += ' hit-good';
    } else if (quality === 'miss') {
        state.combo = 0;
        state.multiplier = 1;
        state.misses++;
        float.innerText = 'MISS';
        float.className += ' hit-miss';
    }

    if (state.combo > state.maxCombo) state.maxCombo = state.combo;

    // Update Multiplier
    if (state.combo > 30) state.multiplier = 4;
    else if (state.combo > 20) state.multiplier = 3;
    else if (state.combo > 10) state.multiplier = 2;
    else state.multiplier = 1;

    // Update UI
    scoreEl.innerText = state.score;
    comboEl.innerText = state.combo;
    multEl.innerText = `x${state.multiplier}.0 Multiplier`;
    
    document.getElementById('stat-perfect').innerText = state.perfects;
    document.getElementById('stat-good').innerText = state.goods;
    document.getElementById('stat-miss').innerText = state.misses;

    // Animte floating text
    feedbackContainer.innerHTML = ''; // Clear old
    feedbackContainer.appendChild(float);
    
    // Animate out
    requestAnimationFrame(() => {
        float.style.transform = 'translate(-50%, -50px) scale(1.5)';
        float.style.opacity = '0';
    });
    setTimeout(() => float.remove(), 500);
}

// Keyboard Listeners
window.addEventListener('keydown', (e) => {
    if (e.repeat) return;
    const laneIndex = KEY_MAPPING.indexOf(e.code);
    if (laneIndex !== -1) handleInput(laneIndex);
});

// Touch Listeners
document.querySelectorAll('[data-key]').forEach((el, index) => {
    el.addEventListener('touchstart', (e) => {
        e.preventDefault();
        handleInput(index);
    });
});


// --- SOLANA / WALLET MOCK ---

const walletBtn = document.getElementById('wallet-btn');
const tokenDisplay = document.getElementById('token-display');
const balanceEl = document.getElementById('hzmz-balance');

walletBtn.addEventListener('click', async () => {
    if (state.walletConnected) return;

    walletBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Connecting...';
    
    // Simulate delay
    setTimeout(() => {
        state.walletConnected = true;
        // Generate random mock address
        const addr = '8x' + Math.random().toString(36).substring(2, 6) + '...' + Math.random().toString(36).substring(2, 5);
        state.walletAddress = addr;
        
        walletBtn.innerHTML = `<i class="fa-brands fa-solana"></i> ${addr}`;
        walletBtn.classList.remove('text-green-400', 'border-green-500');
        walletBtn.classList.add('text-purple-400', 'border-purple-500');
        
        tokenDisplay.classList.remove('hidden');
        tokenDisplay.classList.add('flex');
    }, 1500);
});

function calculateRewards() {
    // 1000 points = 1 HZMZ token
    return (state.score / 1000).toFixed(2);
}

document.getElementById('claim-btn').addEventListener('click', () => {
    const btn = document.getElementById('claim-btn');
    if(!state.walletConnected) {
        alert("Please connect your wallet first!");
        return;
    }
    
    const amount = calculateRewards();
    if(parseFloat(amount) <= 0) return;

    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> MINTING...';
    
    setTimeout(() => {
        state.hzmzBalance += parseFloat(amount);
        balanceEl.innerText = state.hzmzBalance.toFixed(2);
        btn.innerHTML = '<i class="fa-solid fa-check"></i> CLAIMED';
        btn.disabled = true;
        btn.classList.add('opacity-50');
        
        // Show success toast
        const toast = document.createElement('div');
        toast.className = 'absolute top-20 left-1/2 transform -translate-x-1/2 bg-green-900 border border-green-500 text-white px-6 py-3 rounded shadow-lg z-50 flex items-center gap-2';
        toast.innerHTML = `<i class="fa-brands fa-solana"></i> Sent ${amount} HZMZ to ${state.walletAddress}`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
        
    }, 2000);
});


// --- GAME FLOW ---

const startScreen = document.getElementById('start-screen');
const resultsScreen = document.getElementById('results-screen');
const gameUi = document.getElementById('game-ui');

document.getElementById('start-btn').addEventListener('click', () => {
    AudioEngine.init();
    startGame();
});

document.getElementById('restart-btn').addEventListener('click', () => {
    startGame();
});

function startGame() {
    // Reset State
    state.score = 0;
    state.combo = 0;
    state.multiplier = 1;
    state.notes = [];
    state.perfects = 0;
    state.goods = 0;
    state.misses = 0;
    state.isPlaying = true;

    // Reset UI
    document.getElementById('score').innerText = '0';
    document.getElementById('combo').innerText = '0';
    document.getElementById('stat-perfect').innerText = '0';
    document.getElementById('stat-good').innerText = '0';
    document.getElementById('stat-miss').innerText = '0';
    
    startScreen.classList.add('hidden');
    resultsScreen.classList.add('hidden');
    gameUi.classList.remove('hidden');
    gameUi.classList.add('flex');

    AudioEngine.start();
    gameLoop();

    // Game Duration (e.g., 60 seconds for demo)
    setTimeout(endGame, 60000);
}

function endGame() {
    state.isPlaying = false;
    AudioEngine.stop();
    cancelAnimationFrame(animationFrameId);

    gameUi.classList.add('hidden');
    resultsScreen.classList.remove('hidden');

    document.getElementById('final-score').innerText = state.score;
    document.getElementById('final-combo').innerText = state.maxCombo;
    
    const earned = calculateRewards();
    document.getElementById('hzmz-earned').innerText = earned;
    
    // Reset claim button
    const claimBtn = document.getElementById('claim-btn');
    claimBtn.innerHTML = '<i class="fa-solid fa-coins mr-2"></i> CLAIM TOKENS';
    claimBtn.disabled = false;
    claimBtn.classList.remove('opacity-50');
}

</script>
</body>
</html>

export async function swapSolForHZMZ(connection, wallet, amountSol) {
  const raydium = new Raydium(connection);
  
  // Step 1: Get the associated token account for HZMZ for the user's wallet
  const hzmzTokenAccount = await getAssociatedTokenAddress(
    new PublicKey(HZMZ_MINT_ADDRESS),
    wallet.publicKey

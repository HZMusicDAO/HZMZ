// app.js
const express = require('express');
const axios = require('axios');
const bodyParser = require('body-parser');

const app = express();
const port = 8080;

app.use(bodyParser.json());

const CHARTMETRIC_API_URL = 'https://api.chartmetric.com/api';
const CHARTMETRIC_API_KEY = 'your_chartmetric_api_key'; // Replace with your API key

// Function to fetch Chartmetric data (e.g., song streams)
async function fetchStreamingData(trackId) {
  try {
    const response = await axios.get(`${CHARTMETRIC_API_URL}/track/${trackId}/streaming`, {
      headers: {
        'Authorization': `Bearer ${CHARTMETRIC_API_KEY}`,
      },
    });
    return response.data;
  } catch (error) {
    console.error('Error fetching streaming data:', error);
    return null;
  }
}

// Endpoint for Chainlink node to hit
app.post('/streaming', async (req, res) => {
  const { id, data } = req.body;
  const { trackId } = data;

  if (!trackId) {
    return res.status(400).json({ error: 'Missing trackId in request body' });
  }

  const streamingData = await fetchStreamingData(trackId);

  if (!streamingData) {
    return res.status(500).json({ error: 'Error fetching streaming data from Chartmetric' });
  }

  // Respond with the data in the format Chainlink expects
  res.status(200).json({
    jobRunID: id,
    data: {
      spotifyMonthlyListeners: streamingData.spotify.monthly_listeners,
      appleMusicStreams: streamingData.apple.music_streams,
    },
  });
});

// Start the server
app.listen(port, () => {
  console.log(`External adapter listening at http://localhost:${port}`);
});
Explanation:

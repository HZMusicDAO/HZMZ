// src/services/buyNFT.js

import { PublicKey, Transaction, SystemProgram } from "@solana/web3.js";

export async function buyNFT(connection, wallet, nftMintAddress, price) {
  const mintPublicKey = new PublicKey(nftMintAddress);

  // Create a transaction for the NFT purchase
  const transaction = new Transaction().add(
    SystemProgram.transfer({
      fromPubkey: wallet.publicKey,
      toPubkey: mintPublicKey, // Magic Eden marketplace would handle the receiver
      lamports: price * 10 ** 9, // Convert SOL to lamports
    })
  );

  // Send the transaction
  const signature = await wallet.sendTransaction(transaction, connection);
  await connection.confirmTransaction(signature);

  console.log("NFT Purchase complete. Signature:", signature);
  return signature;
}

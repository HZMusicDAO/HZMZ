pub fn update_streaming_data(
    ctx: Context<UpdateStreamingData>,
    spotify_listeners: u64,
    apple_streams: u64,
) -> Result<()> {
    let revenue_account = &mut ctx.accounts.revenue_account;

    // Calculate growth rate for Spotify listeners
    if revenue_account.previous_spotify_listeners > 0 {
        let diff_spotify = spotify_listeners as i64 - revenue_account.previous_spotify_listeners as i64;
        let growth_spotify = (diff_spotify * 10000) / revenue_account.previous_spotify_listeners as i64; // in basis points (e.g., 1000 = 10%)
        revenue_account.growth_rate_spotify = growth_spotify as u64;
    }

    // Calculate growth rate for Apple Music streams
    if revenue_account.previous_apple_music_streams > 0 {
        let diff_apple = apple_streams as i64 - revenue_account.previous_apple_music_streams as i64;
        let growth_apple = (diff_apple * 10000) / revenue_account.previous_apple_music_streams as i64; // in basis points
        revenue_account.growth_rate_apple = growth_apple as u64;
    }

    // Store the current data as the new "previous" data for the next update
    revenue_account.previous_spotify_listeners = spotify_listeners;
    revenue_account.previous_apple_music_streams = apple_streams;

    // Update the current listener/stream count
    revenue_account.spotify_listeners = spotify_listeners;

// app.js

const express = require('express');
const axios = require('axios');
const bodyParser = require('body-parser');

const app = express();
const port = process.env.PORT || 8080;

app.use(bodyParser.json());

const CHARTMETRIC_API_URL = 'https://api.chartmetric.com/api';
const CHARTMETRIC_API_KEY = 'your_chartmetric_api_key'; // Replace with your actual API key

// Function to fetch Chartmetric track metrics
const getTrackMetrics = async (trackId) => {
  try {
    const response = await axios.get(`${CHARTMETRIC_API_URL}/track/${trackId}/streaming`, {
      headers: {
        Authorization: `Bearer ${CHARTMETRIC_API_KEY}`,
      },
    });
    return response.data;
  } catch (error) {
    console.error('Error fetching track data:', error);
    return null;
  }
};

// Endpoint for the Chainlink node to query
app.post('/metrics', async (req, res) => {
  const trackId = req.body.id || 'default_track_id'; // Use a test track ID or a dynamic ID
  console.log(`Fetching metrics for track ID: ${trackId}`);

  const data = await getTrackMetrics(trackId);

  if (!data) {
    return res.status(500).send({
      jobRunID: req.body.id,
      status: 'errored',
      error: 'Error fetching data',
    });
  }

  // Respond in the format Chainlink expects
  const responseData = {
    jobRunID: req.body.id,
    data: {
      spotifyMonthlyListeners: data.spotify.monthly_listeners,
      appleMusicStreams: data.apple.music_streams,
    },
    status: 'completed',
  };

  return res.status(200).send(responseData);
});

// Start the server
app.listen(port, () => {
  console.log(`External adapter listening at http://localhost:${port}`);
});

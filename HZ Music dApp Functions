  }

  // Step 2: Perform the swap
  const swapInstruction = await raydium.swap({
    pool: new PublicKey(RAYDIUM_POOL_ADDRESS),
    user: wallet.publicKey,
    inputTokenMint: new PublicKey(SOL_MINT_ADDRESS),
    outputTokenMint: new PublicKey(HZMZ_MINT_ADDRESS),
    amountIn: amountSol * 10 ** 9, // Convert SOL to lamports
    minimumOutputAmount: 0 // Minimum amount of HZMZ you expect to receive
  });

  // Step 3: Create and sign the transaction
  const transaction = new Transaction().add(swapInstruction);
  const signature = await wallet.sendTransaction(transaction, connection);
  
  // Wait for confirmation
  await connection.confirmTransaction(signature);

  console.log("Swap completed. Signature:", signature);
  return signature;

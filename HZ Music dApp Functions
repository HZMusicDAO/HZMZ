pub fn update_streaming_data(
    ctx: Context<UpdateStreamingData>,
    spotify_listeners: u64,
    apple_streams: u64,
) -> Result<()> {
    let revenue_account = &mut ctx.accounts.revenue_account;

    // Calculate Spotify growth rate
    if revenue_account.previous_spotify_listeners > 0 {
        let diff_spotify = spotify_listeners as i64 - revenue_account.previous_spotify_listeners as i64;
        let growth_spotify = (diff_spotify * 10000) / revenue_account.previous_spotify_listeners as i64; // in basis points
        revenue_account.growth_rate_spotify = growth_spotify as u64;
    }

    // Calculate Apple Music growth rate
    if revenue_account.previous_apple_music_streams > 0 {
        let diff_apple = apple_streams as i64 - revenue_account.previous_apple_music_streams as i64;
        let growth_apple = (diff_apple * 10000) / revenue_account.previous_apple_music_streams as i64; // in basis points
        revenue_account.growth_rate_apple = growth_apple as u64;
    }

    // Update previous listeners to the current week
    revenue_account.previous_spotify_listeners = spotify_listeners;
    revenue_account.previous_apple_music_streams = apple_streams;

    // Update current listeners count
    revenue_account.spotify_listeners = spotify_listeners;
    revenue_account.apple_music_streams = apple_streams;

    // Calculate base royalties for this week
    let base_royalties = (spotify_listeners * 10 + apple_streams * 5) / 1000;

    // Calculate projected royalties based on growth rate
    let projected_royalties_spotify = base_royalties
        + (base_royalties * revenue_account.growth_rate_spotify) / 10000;
    let projected_royalties_apple = base_royalties
        + (base_royalties * revenue_account.growth_rate_apple) / 10000;

    // Store the projected royalties
    revenue_account.projection_royalties =
        (projected_royalties_spotify + projected_royalties_apple) / 2; // Average of both projections

    // Update the total royalties (optional, or use in a different logic)
    revenue_account.total_royalties += revenue_account.projection_royalties;

    Ok(())
}
